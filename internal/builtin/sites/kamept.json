{
  "id": "kamept",
  "name": "KamePT",
  "domain": "https://kamept.com",
  "encoding": "UTF-8",
  "public": false,
  "html": {
    "search": {
      "paths": [
        {
          "path": "torrents.php",
          "method": "get"
        }
      ],
      "params": {
        "notnewword": 1,
        "search": "{keyword}"
      },
      "batch": {
        "delimiter": " ",
        "space_replace": "_"
      },
      "fields": {
        "checkboxes": [
          {
            "name": "cat",
            "type": "bool",
            "label": "分类",
            "options": [
              {
                "name": "cat410",
                "value": "1",
                "label": "同人AV",
                "query": "cat410=1"
              },
              {
                "name": "cat413",
                "value": "1",
                "label": "男娘",
                "query": "cat413=1"
              },
              {
                "name": "cat414",
                "value": "1",
                "label": "同人VR",
                "query": "cat414=1"
              },
              {
                "name": "cat417",
                "value": "1",
                "label": "Cosplay套图",
                "query": "cat417=1"
              },
              {
                "name": "cat419",
                "value": "1",
                "label": "里番",
                "query": "cat419=1"
              },
              {
                "name": "cat411",
                "value": "1",
                "label": "2D动画",
                "query": "cat411=1"
              },
              {
                "name": "cat423",
                "value": "1",
                "label": "3D动画",
                "query": "cat423=1"
              },
              {
                "name": "cat433",
                "value": "1",
                "label": "画师CG",
                "query": "cat433=1"
              },
              {
                "name": "cat435",
                "value": "1",
                "label": "同人志",
                "query": "cat435=1"
              },
              {
                "name": "cat424",
                "value": "1",
                "label": "单行本",
                "query": "cat424=1"
              },
              {
                "name": "cat415",
                "value": "1",
                "label": "非中文游戏",
                "query": "cat415=1"
              },
              {
                "name": "cat418",
                "value": "1",
                "label": "中文游戏",
                "query": "cat418=1"
              },
              {
                "name": "cat434",
                "value": "1",
                "label": "游戏CG",
                "query": "cat434=1"
              },
              {
                "name": "cat437",
                "value": "1",
                "label": "音乐",
                "query": "cat437=1"
              },
              {
                "name": "cat420",
                "value": "1",
                "label": "外语音声",
                "query": "cat420=1"
              },
              {
                "name": "cat421",
                "value": "1",
                "label": "中文音声",
                "query": "cat421=1"
              },
              {
                "name": "cat422",
                "value": "1",
                "label": "视频音声",
                "query": "cat422=1"
              },
              {
                "name": "cat438",
                "value": "1",
                "label": "去码同人AV",
                "query": "cat438=1"
              },
              {
                "name": "cat439",
                "value": "1",
                "label": "去码男娘",
                "query": "cat439=1"
              }
            ]
          },
          {
            "name": "source",
            "type": "bool",
            "label": "马赛克",
            "options": [
              {
                "name": "source1",
                "value": "1",
                "label": "全身无码",
                "query": "source1=1"
              },
              {
                "name": "source2",
                "value": "1",
                "label": "下体无码",
                "query": "source2=1"
              },
              {
                "name": "source3",
                "value": "1",
                "label": "脸部无码",
                "query": "source3=1"
              },
              {
                "name": "source4",
                "value": "1",
                "label": "全身有码",
                "query": "source4=1"
              },
              {
                "name": "source6",
                "value": "1",
                "label": "Other",
                "query": "source6=1"
              },
              {
                "name": "source7",
                "value": "1",
                "label": "不漏点软色情",
                "query": "source7=1"
              }
            ]
          },
          {
            "name": "team",
            "type": "bool",
            "label": "中文字幕",
            "options": [
              {
                "name": "team1",
                "value": "1",
                "label": "中文字幕",
                "query": "team1=1"
              }
            ]
          }
        ],
        "tags": {
          "name": "tag_id",
          "type": "tag",
          "label": "标签",
          "query": "tag_id={{value}}",
          "exclusive": true,
          "options": [
            {
              "value": "14",
              "label": "原盘",
              "query": "tag_id=14"
            },
            {
              "value": "8",
              "label": "中文字幕",
              "query": "tag_id=8"
            },
            {
              "value": "1",
              "label": "禁转",
              "query": "tag_id=1"
            },
            {
              "value": "2",
              "label": "自购",
              "query": "tag_id=2"
            },
            {
              "value": "6",
              "label": "合集",
              "query": "tag_id=6"
            },
            {
              "value": "7",
              "label": "新作",
              "query": "tag_id=7"
            },
            {
              "value": "17",
              "label": "非原档",
              "query": "tag_id=17"
            },
            {
              "value": "16",
              "label": "不漏点软色情",
              "query": "tag_id=16"
            },
            {
              "value": "15",
              "label": "有水印",
              "query": "tag_id=15"
            },
            {
              "value": "13",
              "label": "全身有码",
              "query": "tag_id=13"
            },
            {
              "value": "12",
              "label": "脸部无码",
              "query": "tag_id=12"
            },
            {
              "value": "11",
              "label": "下身无码",
              "query": "tag_id=11"
            },
            {
              "value": "10",
              "label": "全身无码",
              "query": "tag_id=10"
            },
            {
              "value": "9",
              "label": "口罩/面具等",
              "query": "tag_id=9"
            }
          ]
        },
        "selects": [
          {
            "name": "incldead",
            "type": "select",
            "label": "显示断种/活种",
            "query": "incldead={{value}}",
            "options": [
              {
                "value": "0",
                "label": "包括断种",
                "query": "incldead=0"
              },
              {
                "value": "1",
                "label": "活种",
                "query": "incldead=1"
              },
              {
                "value": "2",
                "label": "断种",
                "query": "incldead=2"
              }
            ]
          },
          {
            "name": "spstate",
            "type": "select",
            "label": "显示促销种子",
            "query": "spstate={{value}}",
            "options": [
              {
                "value": "0",
                "label": "全部",
                "query": "spstate=0"
              },
              {
                "value": "1",
                "label": "普通",
                "query": "spstate=1"
              },
              {
                "value": "2",
                "label": "免费",
                "query": "spstate=2"
              },
              {
                "value": "3",
                "label": "2X",
                "query": "spstate=3"
              },
              {
                "value": "4",
                "label": "2X免费",
                "query": "spstate=4"
              },
              {
                "value": "5",
                "label": "50%",
                "query": "spstate=5"
              },
              {
                "value": "6",
                "label": "2X 50%",
                "query": "spstate=6"
              },
              {
                "value": "7",
                "label": "30%",
                "query": "spstate=7"
              }
            ]
          },
          {
            "name": "inclbookmarked",
            "type": "select",
            "label": "显示收藏",
            "query": "inclbookmarked={{value}}",
            "options": [
              {
                "value": "0",
                "label": "全部",
                "query": "inclbookmarked=0"
              },
              {
                "value": "1",
                "label": "仅收藏",
                "query": "inclbookmarked=1"
              },
              {
                "value": "2",
                "label": "仅未收藏",
                "query": "inclbookmarked=2"
              }
            ]
          },
          {
            "name": "search_area",
            "type": "select",
            "label": "search_area",
            "query": "search_area={{value}}",
            "options": [
              {
                "value": "0",
                "label": "标题",
                "query": "search_area=0"
              },
              {
                "value": "1",
                "label": "简介",
                "query": "search_area=1"
              },
              {
                "value": "3",
                "label": "发布者",
                "query": "search_area=3"
              }
            ]
          },
          {
            "name": "search_mode",
            "type": "select",
            "label": "search_mode",
            "query": "search_mode={{value}}",
            "options": [
              {
                "value": "0",
                "label": "与",
                "query": "search_mode=0"
              },
              {
                "value": "2",
                "label": "准确",
                "query": "search_mode=2"
              }
            ]
          }
        ],
        "ranges": [
          {
            "name": "size",
            "type": "number_range",
            "label": "体积范围(GB)：",
            "query": "size_begin={{begin}}\u0026size_end={{end}}",
            "begin": "size_begin",
            "end": "size_end"
          },
          {
            "name": "seeders",
            "type": "number_range",
            "label": "做种人数范围：",
            "query": "seeders_begin={{begin}}\u0026seeders_end={{end}}",
            "begin": "seeders_begin",
            "end": "seeders_end"
          },
          {
            "name": "leechers",
            "type": "number_range",
            "label": "下载人数范围：",
            "query": "leechers_begin={{begin}}\u0026leechers_end={{end}}",
            "begin": "leechers_begin",
            "end": "leechers_end"
          },
          {
            "name": "times_completed",
            "type": "number_range",
            "label": "完成次数范围：",
            "query": "times_completed_begin={{begin}}\u0026times_completed_end={{end}}",
            "begin": "times_completed_begin",
            "end": "times_completed_end"
          },
          {
            "name": "added",
            "type": "date_range",
            "label": "发布时间范围：",
            "query": "added_begin={{begin}}\u0026added_end={{end}}",
            "begin": "added_begin",
            "end": "added_end"
          }
        ],
        "keyword": {
          "name": "search",
          "type": "string",
          "label": "搜索关键字",
          "query": "search={{value}}"
        }
      }
    },
    "torrents": {
      "list": {
        "selector": "table.torrents \u003e tbody \u003e tr, table.torrents \u003e tr"
      },
      "fields": {
        "category": {
          "attribute": "href",
          "filters": [
            {
              "args": [
                "?",
                ""
              ],
              "name": "replace"
            },
            {
              "args": "cat",
              "name": "querystring"
            }
          ],
          "selector": "a[href*=\"?cat=\"]"
        },
        "category_name": {
          "attributes": [
            "alt",
            "title"
          ],
          "selector": "td:nth-child(1) img"
        },
        "comments": {
          "optional": true,
          "selector": "td:nth-child(3)"
        },
        "cover": {
          "attributes": [
            "data-src",
            "src"
          ],
          "optional": true,
          "selector": "table.torrentname img.nexus-lazy-load"
        },
        "date": {
          "filters": [
            {
              "args": "%Y-%m-%d %H:%M:%S",
              "name": "dateparse"
            }
          ],
          "text": "{% if fields['date_elapsed'] or fields['date_added'] %}{{ fields['date_elapsed'] if fields['date_elapsed'] else fields['date_added'] }}{% else %}now{% endif %}"
        },
        "date_added": {
          "attribute": "title",
          "optional": true,
          "selector": "td:nth-child(4) \u003e span"
        },
        "date_elapsed": {
          "optional": true,
          "selector": "td:nth-child(4) \u003e span"
        },
        "details": {
          "attribute": "href",
          "selector": "a[href*=\"details.php?id=\"]"
        },
        "download": {
          "attribute": "href",
          "selector": "a[href*=\"download.php?id=\"]"
        },
        "downloadvolumefactor": {
          "case": {
            "*": 1,
            "img.pro_30pctdown": 0.3,
            "img.pro_50pctdown": 0.5,
            "img.pro_50pctdown2up": 0.5,
            "img.pro_free": 0,
            "img.pro_free2up": 0
          }
        },
        "free_deadline": {
          "attribute": "onmouseover",
          "default_value": "{% if fields['downloadvolumefactor']==0 %}{{max_time}}{% endif%}",
          "default_value_format": "%Y-%m-%d %H:%M:%S.%f",
          "filters": [
            {
              "args": [
                "\\d+-\\d+-\\d+ \\d+:\\d+:\\d+",
                0
              ],
              "name": "re_search"
            },
            {
              "args": "%Y-%m-%d %H:%M:%S",
              "name": "dateparse"
            }
          ],
          "selector": "img.pro_free,img.pro_free2up"
        },
        "grabs": {
          "selector": "td:nth-child(8)"
        },
        "id": {
          "attribute": "href",
          "filters": [
            {
              "args": [
                "\\d+",
                0
              ],
              "name": "re_search"
            }
          ],
          "selector": "a[href*=\"details.php?id=\"]"
        },
        "tag_ids": {
          "selector": "td.embedded \u003e span[style*=\"background-color\"]"
        },
        "leechers": {
          "selector": "td:nth-child(7)"
        },
        "seeders": {
          "selector": "td:nth-child(6)"
        },
        "size": {
          "selector": "td:nth-child(5)"
        },
        "snatches": {
          "selector": "td:nth-child(8)"
        },
        "subtitle": {
          "after": "br",
          "remove": [
            "a",
            "img",
            "font",
            "span",
            "div"
          ],
          "selector": "table.torrentname td.embedded:nth-child(2)",
          "optional": true
        },
        "tags": {
          "after": "br",
          "max_length": 32,
          "remove": [
            "a",
            "img",
            "font",
            "span",
            "div"
          ],
          "selector": "table.torrentname td.embedded:nth-child(2)",
          "split": "whitespace"
        },
        "title": {
          "text": "{% if fields['title_optional'] %}{{ fields['title_optional'] }}{% else %}{{ fields['title_default'] }}{% endif %}"
        },
        "title_default": {
          "selector": "a[href*=\"details.php?id=\"]"
        },
        "title_optional": {
          "attribute": "title",
          "optional": true,
          "selector": "a[title][href*=\"details.php?id=\"]"
        },
        "uploadvolumefactor": {
          "case": {
            "*": 1,
            "img.pro_2up": 2,
            "img.pro_50pctdown2up": 2,
            "img.pro_free2up": 2
          }
        }
      },
      "browse_list": {
        "selector": ""
      }
    },
    "browse": {},
    "conf": {
      "2XFREE": [
        "//h1[@id='top']/b/font[@class='twoupfree']"
      ],
      "FREE": [
        "//h1[@id='top']/b/font[@class='free']"
      ],
      "PEER_COUNT": [
        "//div[@id='peercount']/b[1]"
      ]
    }
  },
  "detail_page_url": "/details.php?id={tid}",
  "request_rules": [
    {
      "domain_suffix": "p.kamept.com",
      "cookie_names": [
        "cf_clearance"
      ]
    }
  ]
}
