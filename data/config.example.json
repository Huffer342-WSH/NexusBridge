    "level": "debug",
    "file": "logs/nexusbridge.log",
    "log_sensitive_fetch": false
  },
  "auth": {
    "enabled": false,
    "username": "",
    "password": ""
  },
  "qbittorrent": {
    "auth_mode": "uid",
    "url": "http://127.0.0.1:8080",
    "api_key": "",
    "username": "",
