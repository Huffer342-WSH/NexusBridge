      "max_size": 0,
      "min_seeders": 0,
      "max_seeders": 0,
      "min_leechers": 0,
      "max_leechers": 0,
      "min_snatches": 0,
      "max_snatches": 0,
      "published_within_minutes": 0,
      "sort_by": "source_order",
      "sort_direction": "asc",
      "action": "download"
    }
  ]
}
