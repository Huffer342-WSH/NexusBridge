    "tags": ["nexusbridge"],
    "auto_sync": true,
    "sync_interval_seconds": 3,
    "inactive_sync_interval_seconds": 30,
    "disconnected_sync_interval_seconds": 60
  },
  "llm": {
    "base_url": "",
    "api_key": "",
    "model": ""
  },
  "media_library": {
    "root": "",
    "dry_run": true
  },
  "rules": [
    {
      "name": "示例筛选规则",
      "site_ids": [],
      "site_categories": [],
      "site_tags": [],
      "subtitle_tags": [],
